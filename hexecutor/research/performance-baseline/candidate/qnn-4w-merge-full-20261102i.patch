@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+"""Convert the QNN hook's preprocessed ExecEntry capture into a graph-keyed plan.
+
+The output preserves the two independently ordered lists and their real shared
+checkpoint slots.  It is a provenance/host-model artifact; it does not execute
+QNN operations or infer dependencies from tensor edges.
+"""
+import argparse
+import hashlib
+import json
+import re
+import struct
+from collections import Counter
+from pathlib import Path
+
+DMA_EVENT_NONE = 0xFFFF
+DMA_KIND_NONE = 0
+DMA_KIND_SET = 1
+DMA_KIND_WAIT = 2
+
+
+def parse_capture(path):
+    headers, rows = {}, []
+    def ptr(text):
+        return 0 if text == "(nil)" else int(text, 16)
+    for line in Path(path).read_text().splitlines():
+        if not line.strip():
+            continue
+        if line.startswith("# QD_RUNLIST_METADATA_CAPTURE_V1"):
+            m = re.search(r"list (\d+) base=(0x[0-9a-fA-F]+) count=(\d+) entry_bytes=(\d+)", line)
+            if not m:
+                raise ValueError(f"malformed capture header: {line}")
+            lid, base, count, size = int(m[1]), int(m[2], 16), int(m[3]), int(m[4])
+            if lid in headers or size != 32:
+                raise ValueError(f"duplicate/invalid run list header: {line}")
+            headers[lid] = {"base": base, "count": count, "entry_bytes": size}
+            continue
+        f = line.split()
+        if len(f) != 8:
+            raise ValueError(f"malformed entry: {line}")
+        rows.append({"list": int(f[0]), "index": int(f[1]), "function": int(f[2], 16),
+                     "op_ptr": ptr(f[3]), "wait_ptr": ptr(f[4]),
+                     "done_ptr": ptr(f[5]), "wait_value": int(f[6], 16),
+                     "done_value": int(f[7], 16)})
+    if set(headers) != {0, 1}:
+        raise ValueError(f"expected both preprocessed lists 0 and 1, got {sorted(headers)}")
+    cp_bases = {r["wait_ptr"] for r in rows} | {r["done_ptr"] for r in rows}
+    cp_base = min(cp_bases)
+    if any(p < cp_base or (p - cp_base) % 4 for p in cp_bases):
+        raise ValueError("checkpoint pointer is outside/alignment-invalid for captured table")
+    for lid, h in headers.items():
+        n = [r for r in rows if r["list"] == lid]
+        if len(n) != h["count"] or sorted(r["index"] for r in n) != list(range(h["count"])):
+            raise ValueError(f"list {lid} has a count/index gap")
+    return headers, rows, cp_base
+
+
+def build(graph, capture):
+    headers, rows, cp_base = parse_capture(capture)
+    by_key = {(r["list"], r["index"]): r for r in rows}
+    graph_nodes = graph["nodes"]
+    main_nodes = iter(n for n in graph_nodes if n["flags"] in (0, 2))
+    worker_nodes = iter(n for n in graph_nodes if n["flags"] in (4, 6))
+    pad_nodes = iter(n for n in graph_nodes if n["flags"] == 6)
+    lists = []
+    cp_values = {}
+    done_producers = Counter()
+    done_by_list = [Counter(), Counter()]
+    for lid in (0, 1):
+        entries = []
+        for idx in range(headers[lid]["count"]):
+            raw = by_key[lid, idx]
+            node = None
+            if lid == 0:
+                if raw["function"] == 0xebc680:  # QNN 2.50 InputSlicePad executor stub
+                    # The serialized node is a worker op; this main-list slot is
+                    # an executor-only no-op with cp0 wait/done pointers.
+                    node = next(pad_nodes, None)
+                else:
+                    node = next(main_nodes, None)
+            else:
+                node = next(worker_nodes, None)
+            wait_cp = (raw["wait_ptr"] - cp_base) // 4
+            done_cp = (raw["done_ptr"] - cp_base) // 4
+            for cp, value in ((wait_cp, raw["wait_value"]), (done_cp, raw["done_value"])):
+                old = cp_values.setdefault(cp, value)
+                if old != value:
+                    raise ValueError(f"checkpoint {cp} has inconsistent captured initial values")
+            if node is not None and node["flags"] != 6 or lid == 1:
+                if done_cp:
+                    done_producers[done_cp] += 1
+                    done_by_list[lid][done_cp] += 1
+            if node is not None and not (lid == 0 and raw["function"] == 0xebc680):
+                cps = node.get("checkpoints", [])
+                expected = (cps[0], cps[1]) if len(cps) == 2 else ((0, cps[0]) if len(cps) == 1 else None)
+                if expected is not None and expected != (wait_cp, done_cp):
+                    raise ValueError(f"graph/capture checkpoint mismatch for node {node['sequence']}")
+            dma_type = node.get("type_name") if node else None
+            if dma_type in ("@DmaCheckpointSet", "@DmaCheckpointWait"):
+                words = node.get("framework_words", [])
+                if len(words) != 1 or not 0 < words[0] < DMA_EVENT_NONE:
+                    raise ValueError(f"invalid DMA checkpoint payload at node {node['sequence']}")
+                if lid != 0 or node.get("flags") not in (0, 2):
+                    raise ValueError(f"DMA checkpoint node {node['sequence']} is not on the main list")
+                dma_event_id = words[0]
+                dma_event_kind = DMA_KIND_SET if dma_type == "@DmaCheckpointSet" else DMA_KIND_WAIT
+            else:
+                dma_event_id = DMA_EVENT_NONE
+                dma_event_kind = DMA_KIND_NONE
+            entries.append({"index": idx, "node_sequence": node["sequence"] if node else None,
+                            "flags": node["flags"] if node else None,
+                            "function_offset": raw["function"], "wait_cp": wait_cp,
+                            "done_cp": done_cp, "wait_value": raw["wait_value"],
+                            "done_value": raw["done_value"],
+                            "dma_event_id": dma_event_id,
+                            "dma_event_kind": dma_event_kind,
+                            "dma_type": dma_type,
+                            "synthetic_main_stub": lid == 0 and raw["function"] == 0xebc680})
+        lists.append({"id": lid, "entry_count": len(entries), "entries": entries})
+    if next(main_nodes, None) is not None or next(worker_nodes, None) is not None or next(pad_nodes, None) is not None:
+        raise ValueError("captured run lists did not consume the graph's executable nodes")
+    for cp, count in done_producers.items():
+        if cp_values.get(cp) != count:
+            raise ValueError(f"checkpoint {cp}: initial count {cp_values.get(cp)} != producer entries {count}")
+        if done_by_list[0][cp] and done_by_list[1][cp]:
+            raise ValueError(f"checkpoint {cp} has producers on both lists; split counters would race")
+    if cp_values.get(0) != 0:
+        raise ValueError("checkpoint zero sentinel is not initialized to zero")
+    cp_count = max(cp_values) + 1
+    cp_owner = [255 if i == 0 else (0 if done_by_list[0][i] else 1 if done_by_list[1][i] else 255)
+                for i in range(cp_count)]
+    return {"format": "QD_QNN_RUNLIST_PLAN_V1",
+            "context_sha256": graph["context_sha256"],
+            "capture_sha256": hashlib.sha256(Path(capture).read_bytes()).hexdigest(),
+            "checkpoint_slots": cp_count,
+            "checkpoint_initial_values": [cp_values.get(i, 0) for i in range(cp_count)],
+            "checkpoint_owner": cp_owner,
+            "lists": lists,
+            "semantics": {"wait_ready_when": "checkpoint[wait_cp] == 0",
+                          "done_after_completion": "decrement done_cp after handler completion; release waiters on zero",
+                          "dma_checkpoints": "separate from ExecEntry wait/done CPs; event ID is framework_words[0] on @DmaCheckpointSet/Wait",
+                          "cp0": "sentinel; main synthetic stubs carry cp0/cp0 and have no graph effect"}}
+
+
+def validate_schedule(plan, worker_first=False):
+    """Host-only ready-list scheduler model; returns completed graph nodes."""
+    counters = plan["checkpoint_initial_values"][:]
+    cursors = [0, 0]
+    lists = plan["lists"]
+    done = []
+    while cursors[0] < len(lists[0]["entries"]) or cursors[1] < len(lists[1]["entries"]):
+        order = (1, 0) if worker_first else (0, 1)
+        selected = None
+        for lid in order:
+            if cursors[lid] >= len(lists[lid]["entries"]):
+                continue
+            e = lists[lid]["entries"][cursors[lid]]
+            if counters[e["wait_cp"]] == 0:
+                selected = lid, e
+                break
+        if selected is None:
+            raise ValueError(f"deadlock: list cursors={cursors}, nonzero checkpoints=" +
+                             str([(i, v) for i, v in enumerate(counters) if v]))
+        lid, e = selected
+        cp = e["done_cp"]
+        if cp:
+            if counters[cp] == 0:
+                raise ValueError(f"checkpoint {cp} underflow at list {lid} entry {e['index']}")
+            counters[cp] -= 1
+        cursors[lid] += 1
+        done.append((lid, e["index"], e.get("command_index"), e["node_sequence"]))
+    if any(counters):
+        raise ValueError(f"schedule ended with live checkpoints: {[i for i,v in enumerate(counters) if v]}")
+    return done
+
+
+def emit_header(plan, path):
+    """Emit a C table suitable for a strict context-SHA-gated runtime path."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    prefix = "nprg2_qnn_primary"
+    lines = ["/* Generated by tools/qnn_runlist_capture.py; do not hand edit. */",
+             "#ifndef NPRG2_QNN_PRIMARY_RUNLIST_GENERATED_H",
+             "#define NPRG2_QNN_PRIMARY_RUNLIST_GENERATED_H",
+             "#include <stdint.h>",
+             "typedef struct { uint16_t command, wait_cp, done_cp, dma_event_id; uint8_t dma_event_kind; } Nprg2QnnRunEntry;",
+             f"#define QD_QNN_PRIMARY_CONTEXT_SHA256 \"{plan['context_sha256']}\"",
+             f"#define QD_QNN_PRIMARY_CAPTURE_SHA256 \"{plan['capture_sha256']}\"",
+             f"#define QD_QNN_PRIMARY_COMMAND_COUNT {sum(x['entry_count'] for x in plan['lists'])}u",
+             f"#define QD_QNN_PRIMARY_CHECKPOINT_COUNT {plan['checkpoint_slots']}u"]
+    context = bytes.fromhex(plan["context_sha256"])
+    lines.append(f"static const uint8_t {prefix}_context_sha[32] = {{")
+    lines.append("    " + ", ".join(f"0x{x:02x}" for x in context) + ",")
+    lines.append("};")
+    cp = plan["checkpoint_initial_values"]
+    lines.append(f"static const uint8_t {prefix}_cp_initial[QD_QNN_PRIMARY_CHECKPOINT_COUNT] = {{")
+    for i in range(0, len(cp), 24):
+        lines.append("    " + ", ".join(str(x) for x in cp[i:i+24]) + ",")
+    lines.append("};")
+    owner = plan["checkpoint_owner"]
+    lines.append(f"static const uint8_t {prefix}_cp_owner[QD_QNN_PRIMARY_CHECKPOINT_COUNT] = {{")
+    for i in range(0, len(owner), 24):
+        lines.append("    " + ", ".join(str(x) for x in owner[i:i+24]) + ",")
+    lines.append("};")
+    for group, suffix in zip(plan["lists"], ("main", "worker")):
+        lines.append(f"#define QD_QNN_PRIMARY_{suffix.upper()}_COUNT {group['entry_count']}u")
+        lines.append(f"static const Nprg2QnnRunEntry {prefix}_{suffix}[QD_QNN_PRIMARY_{suffix.upper()}_COUNT] = {{")
+        for e in group["entries"]:
+            lines.append(f"    {{{e['command_index']}, {e['wait_cp']}, {e['done_cp']}, {e['dma_event_id']}, {e['dma_event_kind']}}},")
+        lines.append("};")
+    lines.extend(["#endif", ""])
+    path.write_text("\n".join(lines))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("graph", type=Path)
+    ap.add_argument("capture", type=Path)
+    ap.add_argument("execution_order", type=Path,
+                    help="recovered execution_order.json, which gives prepared command indices")
+    ap.add_argument("trace", type=Path,
+                    help="trace.log from the same QNN context, used to map duplicate entries to command indices")
+    ap.add_argument("output", type=Path)
+    ap.add_argument("--events-main-first", type=Path)
+    ap.add_argument("--events-worker-first", type=Path)
+    ap.add_argument("--emit-header", type=Path)
+    a = ap.parse_args()
+    graph = json.loads(a.graph.read_text())
+    plan = build(graph, a.capture)
+    order = json.loads(a.execution_order.read_text())
+    trace_rows = []
+    for line in a.trace.read_text().splitlines():
+        if not line.strip() or line.startswith("#"):
+            continue
+        f = line.split()
+        trace_rows.append((int(f[1]), int(f[2])))
+    if order.get("context_sha256") != graph["context_sha256"] or len(order["nodes"]) != len(trace_rows):
+        raise SystemExit("execution order / trace does not match the source graph")
+    entry_by_key = {(lid, e["index"]): e for group in plan["lists"] for lid in (group["id"],)
+                    for e in group["entries"]}
+    for command_index, ((lid, entry_index), sequence) in enumerate(zip(trace_rows, order["nodes"])):
+        e = entry_by_key.get((lid, entry_index))
+        if e is None or e["node_sequence"] != sequence:
+            raise SystemExit(f"trace-to-command mismatch at command {command_index}: {(lid, entry_index)} / {sequence}")
+        e["command_index"] = command_index
+    if any("command_index" not in e for group in plan["lists"] for e in group["entries"]):
+        raise SystemExit("not every captured run-list entry maps to a prepared command")
+    main_first = validate_schedule(plan, False)
+    worker_first = validate_schedule(plan, True)
+    if Counter(x[2] for x in main_first) != Counter(x[2] for x in worker_first):
+        raise SystemExit("the two ready-list schedules cover different graph nodes")
+    a.output.parent.mkdir(parents=True, exist_ok=True)
+    plan["host_model_orders"] = {
+        "main_first": [x[2] for x in main_first],
+        "worker_first": [x[2] for x in worker_first],
+    }
+    for path, events in ((a.events_main_first, main_first), (a.events_worker_first, worker_first)):
+        if path is not None:
+            path.parent.mkdir(parents=True, exist_ok=True)
+            with path.open("wb") as f:
+                f.write(struct.pack("<I", plan["checkpoint_slots"]))
+                for value in plan["checkpoint_initial_values"]:
+                    f.write(struct.pack("<I", value))
+                for lid, entry_ix, command_ix, _seq in events:
+                    e = entry_by_key[lid, entry_ix]
+                    f.write(struct.pack("<IIIIII", command_ix, e["wait_cp"], e["done_cp"], lid,
+                                        e["dma_event_id"], e["dma_event_kind"]))
+    a.output.write_text(json.dumps(plan, indent=2) + "\n")
+    if a.emit_header is not None:
+        emit_header(plan, a.emit_header)
+    print(f"wrote {a.output}: lists=" + ",".join(str(x["entry_count"]) for x in plan["lists"]) +
+          f", checkpoints={plan['checkpoint_slots']}, commands={len(main_first)}, "
+          f"main-first={len(main_first)} and worker-first={len(worker_first)} complete")
+
+
+if __name__ == "__main__":
+    main()
