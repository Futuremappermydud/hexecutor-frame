#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0,r32f) uniform readonly image2D leftAnchor;
layout(binding=1,r32f) uniform readonly image2D rightAnchor;
layout(binding=2,rg32ui) uniform writeonly uimage2D leftMask;
layout(binding=3,rg32ui) uniform writeonly uimage2D rightMask;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);bool right=gl_GlobalInvocationID.z!=0u;
    if(any(greaterThanEqual(p,ivec2(616))))return;
    float center=right?imageLoad(rightAnchor,p).r:imageLoad(leftAnchor,p).r;
    uvec2 mask=uvec2(0xffffffffu,0xffffu);int bit=0;
    if(center>0.0)for(int y=-3;y<=3;++y)for(int x=-3;x<=3;++x) {
        if(x==0&&y==0)continue;
        ivec2 q=clamp(p+ivec2(x,y),ivec2(0),ivec2(615));
        float other=right?imageLoad(rightAnchor,q).r:imageLoad(leftAnchor,q).r;
        if(other>0.0&&abs(other-center)>1.0) {
            if(bit<32)mask.x&=~(1u<<bit);else mask.y&=~(1u<<(bit-32));
        }
        ++bit;
    }
    if(right)imageStore(rightMask,p,uvec4(mask,0u,0u));else imageStore(leftMask,p,uvec4(mask,0u,0u));
}
