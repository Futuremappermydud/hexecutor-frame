{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "Room surface marks",
  "bindings": {
    "/actions/marks": {"sources": [
      {"path": "/user/hand/left/input/trigger", "mode": "trigger", "inputs": {"click": {"output": "/actions/marks/in/left_trigger"}}},
      {"path": "/user/hand/left/input/grip", "mode": "trigger", "inputs": {"click": {"output": "/actions/marks/in/left_grip"}}},
      {"path": "/user/hand/right/input/trigger", "mode": "trigger", "inputs": {"click": {"output": "/actions/marks/in/right_trigger"}}},
      {"path": "/user/hand/right/input/grip", "mode": "trigger", "inputs": {"click": {"output": "/actions/marks/in/right_grip"}}}
    ]}
  }
}
