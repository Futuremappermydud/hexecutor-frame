#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, r32f) uniform readonly image2D u_RawDepth;
layout(binding = 1, r32f) uniform writeonly image2D u_FilteredDepth;

#ifdef FRAME_STEREO_DIAGNOSTICS
layout(binding = 2, r32ui) uniform writeonly uimage2D u_Rejection;
#endif
const int WIDTH = 616;
const int HEIGHT = 616;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= WIDTH || p.y >= HEIGHT) return;
    float center = imageLoad(u_RawDepth, p).r;
    if (center <= 0.0 || p.x == 0 || p.y == 0 ||
        p.x == WIDTH - 1 || p.y == HEIGHT - 1) {
#ifdef FRAME_STEREO_DIAGNOSTICS
        imageStore(u_Rejection, p, uvec4(center > 0.0 ? 1u : 0u, 0u, 0u, 0u));
#endif
        imageStore(u_FilteredDepth, p, vec4(0.0));
        return;
    }

    float tolerance = max(0.04, center * 0.04);
    int support = 0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0) continue;
            float neighbor = imageLoad(u_RawDepth, p + ivec2(dx, dy)).r;
            if (neighbor > 0.0 && abs(neighbor - center) <= tolerance) ++support;
        }
    }
#ifdef FRAME_STEREO_DIAGNOSTICS
    imageStore(u_Rejection, p, uvec4(support < 3 ? 1u : 0u, 0u, 0u, 0u));
#endif
    imageStore(u_FilteredDepth, p, vec4(support >= 3 ? center : 0.0));
}
